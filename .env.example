# MediBook Root Environment Variables for Docker Compose
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=medibook

# Secrets (Minimum 32 characters for JWT_SECRET)
JWT_SECRET=medibook-production-jwt-secret-key-32chars-min
CLIENT_URL=http://localhost

# Backend Application Port & Environment
PORT=5000
NODE_ENV=production

# Email Service Configuration (Nodemailer / Mailpit)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=MediBook <no-reply@medibook.test>
LOG_LEVEL=info
METRICS_TOKEN=medibook-internal-metrics-secret-token
