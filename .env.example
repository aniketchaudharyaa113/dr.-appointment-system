# ==========================================
# MediBook / CuraBridge Configuration Template
# Copy to .env for local development and replace all CHANGE_ME_* placeholders.
# IMPORTANT: docker-compose.yml requires all secrets to be set (no weak defaults).
# In NODE_ENV=production, known weak/default secrets and PAYMENT_PROVIDER=FAKE are rejected at boot.
# MinIO, Mailpit, LiveKit, PostgreSQL, and Redis host ports are bound to 127.0.0.1 only.
# ==========================================

# Core Application
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000
COOKIE_SECRET=CHANGE_ME_COOKIE_SECRET_32_CHARS_MINIMUM
ENABLE_DEV_ENDPOINTS=false

# PostgreSQL (PostgreSQL 16 + pgvector + pg_trgm)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
POSTGRES_DB=medibook
DATABASE_URL=postgresql://postgres:CHANGE_ME_POSTGRES_PASSWORD@localhost:5434/medibook?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# Security & JWT (Argon2 + Access JWT + Refresh Tokens)
JWT_SECRET=CHANGE_ME_JWT_SECRET_32_CHARS_MINIMUM
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=7

# Timezone
CLINIC_TIMEZONE=Asia/Kolkata

# Payment Providers (RAZORPAY | STRIPE | FAKE)
PAYMENT_PROVIDER=RAZORPAY
PAYMENT_WEBHOOK_SECRET=CHANGE_ME_PAYMENT_WEBHOOK_SECRET
RAZORPAY_KEY_ID=CHANGE_ME_RAZORPAY_KEY_ID
RAZORPAY_KEY_SECRET=CHANGE_ME_RAZORPAY_KEY_SECRET
RAZORPAY_WEBHOOK_SECRET=CHANGE_ME_RAZORPAY_WEBHOOK_SECRET

# LiveKit WebRTC Video
LIVEKIT_API_KEY=CHANGE_ME_LIVEKIT_API_KEY
LIVEKIT_API_SECRET=CHANGE_ME_LIVEKIT_API_SECRET_32_CHARS_MIN
LIVEKIT_URL=ws://localhost:7880

# MinIO S3 Object Storage
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=CHANGE_ME_MINIO_ACCESS_KEY
MINIO_SECRET_KEY=CHANGE_ME_MINIO_SECRET_KEY
MINIO_BUCKET=medibook-records

# Email / Mailpit
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=

# AI Service (Python FastAPI - internal network only)
AI_SERVICE_URL=http://localhost:8000
AI_INTERNAL_TOKEN=CHANGE_ME_AI_INTERNAL_TOKEN_32_CHARS_MIN
