# ==========================================
# MediBook Production Configuration
# Copy to .env for local development
# ==========================================

# Core Application
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000
COOKIE_SECRET=medibook-super-secure-cookie-secret-32-chars

# PostgreSQL (PostgreSQL 16 + pgvector + pg_trgm)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=medibook
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5434/medibook?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# Security & JWT (Argon2 + Access JWT + Refresh Tokens)
JWT_SECRET=medibook-production-jwt-secret-key-32chars-min
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=7

# Timezone
CLINIC_TIMEZONE=Asia/Kolkata

# Payment Providers (RAZORPAY | STRIPE | FAKE)
PAYMENT_PROVIDER=FAKE
RAZORPAY_KEY_ID=rzp_test_mock_key
RAZORPAY_KEY_SECRET=rzp_test_mock_secret
RAZORPAY_WEBHOOK_SECRET=webhook_secret_123

# LiveKit WebRTC Video
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret_32_characters_minimum_len
LIVEKIT_URL=http://localhost:7880

# MinIO S3 Object Storage
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=medibook-records

# Email / Mailpit
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=

# AI Service (Python FastAPI)
AI_SERVICE_URL=http://localhost:8000
