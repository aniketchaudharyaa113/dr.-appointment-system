  "liveNow": false,
  "panels": [
    {
      "title": "HTTP Request Volume by Endpoint & Status",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum by (path, status_code) (rate(medibook_http_requests_total[1m]))",
          "legendFormat": "{{path}} ({{status_code}})"
        }
      ]
    },
    {
      "title": "Double-Booking Prevention Races & Rejections",
      "type": "stat",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum(increase(medibook_booking_conflicts_total[5m]))",
          "legendFormat": "Slot Conflicts Rejected"
        }
      ]
    },
    {
      "title": "Double-Entry Ledger Invariant Status",
      "type": "stat",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 0 },
      "targets": [
        {
          "expr": "sum(medibook_ledger_zero_sum_checks_total{status='balanced'})",
          "legendFormat": "100% Balanced Zero-Sum"
        }
      ]
    },
    {
      "title": "Payment Webhooks Lag & Processing Outcomes",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "sum by (outcome) (rate(medibook_payment_outcomes_total[1m]))",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "title": "Ambulance Emergency Dispatch Time (P95 Latency)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(medibook_ambulance_dispatch_seconds_bucket[5m])) by (le))",
          "legendFormat": "P95 Dispatch Seconds"
        }
      ]
    }
  ],
